{
  "name": "play-the-word",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "sim": "tsx src/sim/autoplay.ts",
    "sim:materials": "tsx src/sim/materials.ts",
    "normalize:packs": "node scripts/normalize-pack-art.mjs",
    "deploy": "npm run build && gh-pages -d dist",
    "desktop:run": "electron .",
    "build:desktop": "npm run build && node scripts/check-offline.mjs && electron-builder --dir"
  },
  "build": {
    "appId": "com.kdg0711.playtheworld",
    "productName": "Play the World",
    "directories": { "output": "../D1-release" },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "desktop/icon.ico"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
